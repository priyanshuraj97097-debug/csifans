# ---- Server-side only (never exposed to the browser) ----
# Google Gemini API key used by the CSI Support chatbot (/api/chat).
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ---- Build-time public config (safe to expose) ----
# Canonical public origin used for canonical tags, Open Graph, sitemap, robots.
VITE_SITE_URL=https://csifans.pages.dev
